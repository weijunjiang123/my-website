<div class="scroll-progress" aria-hidden="true"><i></i></div>
<div class="pointer-aura" aria-hidden="true"></div>

<script>
  const root = document.documentElement;
  const progress = document.querySelector<HTMLElement>('.scroll-progress i');
  const aura = document.querySelector<HTMLElement>('.pointer-aura');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let sectionLinks: HTMLAnchorElement[] = [];
  let sections: HTMLElement[] = [];
  const pageEntryTimers = new WeakMap<HTMLElement, number>();
  let scrollFrame = 0;
  let pointerFrame = 0;
  let anchorFrame = 0;
  let pointerTargetX = window.innerWidth / 2;
  let pointerTargetY = window.innerHeight / 2;
  let pointerX = pointerTargetX;
  let pointerY = pointerTargetY;
  let lastScrollY = window.scrollY;

  const updateScroll = () => {
    scrollFrame = 0;
    const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    const value = Math.min(Math.max(window.scrollY / max, 0), 1);
    progress?.style.setProperty('--progress', String(value));
    root.classList.toggle('is-scrolled', window.scrollY > 24);
    const delta = window.scrollY - lastScrollY;
    if (Math.abs(delta) > 2) root.dataset.scrollDirection = delta > 0 ? 'down' : 'up';
    lastScrollY = window.scrollY;
    const readingLine = window.scrollY + window.innerHeight * .5;
    let currentId = sections[0]?.id ?? 'top';
    for (const section of sections) {
      if (section.offsetTop <= readingLine) currentId = section.id;
      else break;
    }
    setCurrentSection(currentId);
  };

  const requestScrollUpdate = () => {
    if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScroll);
  };

  const renderPointer = () => {
    pointerX += (pointerTargetX - pointerX) * .16;
    pointerY += (pointerTargetY - pointerY) * .16;
    aura?.style.setProperty('--pointer-x', `${pointerX}px`);
    aura?.style.setProperty('--pointer-y', `${pointerY}px`);
    const isSettled = Math.abs(pointerTargetX - pointerX) < .12 && Math.abs(pointerTargetY - pointerY) < .12;
    if (isSettled) {
      pointerX = pointerTargetX;
      pointerY = pointerTargetY;
      pointerFrame = 0;
      return;
    }
    pointerFrame = window.requestAnimationFrame(renderPointer);
  };

  const onPointerMove = (event: PointerEvent) => {
    pointerTargetX = event.clientX;
    pointerTargetY = event.clientY;
    if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderPointer);
  };

  const revealObserver = new IntersectionObserver((entries, observer) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    }
  }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

  const setCurrentSection = (id: string) => {
    if (root.dataset.section === id) return;
    const hadCurrentSection = root.dataset.section !== undefined;
    const nextIndex = sections.findIndex((section) => section.id === id);
    root.dataset.section = id;
    root.style.setProperty('--chapter-progress', String(nextIndex / Math.max(sections.length - 1, 1)));
    for (const section of sections) {
      const isCurrent = section.id === id;
      section.classList.toggle('is-current-section', isCurrent);
      if (
        isCurrent &&
        hadCurrentSection &&
        !reduceMotion.matches &&
        !root.classList.contains('is-anchor-scrolling')
      ) {
        window.clearTimeout(pageEntryTimers.get(section));
        section.classList.remove('is-page-entering');
        void section.offsetWidth;
        section.classList.add('is-page-entering');
        pageEntryTimers.set(section, window.setTimeout(() => section.classList.remove('is-page-entering'), 560));
      }
    }
    for (const link of sectionLinks) {
      const isCurrent = link.hash === `#${id}`;
      link.classList.toggle('is-current', isCurrent);
      if (isCurrent) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  const cancelAnchorScroll = () => {
    if (!anchorFrame) return;
    window.cancelAnimationFrame(anchorFrame);
    anchorFrame = 0;
    root.classList.remove('is-anchor-scrolling');
    window.removeEventListener('wheel', cancelAnchorScroll);
    window.removeEventListener('touchstart', cancelAnchorScroll);
  };

  const animateToSection = (target: HTMLElement) => {
    cancelAnchorScroll();
    const headerOffset = target.id === 'top' ? 0 : 72;
    const startY = window.scrollY;
    const targetY = Math.min(
      Math.max(target.getBoundingClientRect().top + startY - headerOffset, 0),
      Math.max(document.documentElement.scrollHeight - window.innerHeight, 0),
    );
    const distance = targetY - startY;
    if (Math.abs(distance) < 2) return;
    const duration = Math.min(1100, Math.max(520, Math.abs(distance) * .32));
    const startTime = performance.now();
    root.classList.add('is-anchor-scrolling');
    window.addEventListener('wheel', cancelAnchorScroll, { passive: true });
    window.addEventListener('touchstart', cancelAnchorScroll, { passive: true });

    const step = (now: number) => {
      const progressValue = Math.min((now - startTime) / duration, 1);
      const eased = progressValue < .5
        ? 4 * progressValue ** 3
        : 1 - ((-2 * progressValue + 2) ** 3) / 2;
      window.scrollTo(0, startY + distance * eased);
      if (progressValue < 1) {
        anchorFrame = window.requestAnimationFrame(step);
      } else {
        anchorFrame = 0;
        root.classList.remove('is-anchor-scrolling');
        window.removeEventListener('wheel', cancelAnchorScroll);
        window.removeEventListener('touchstart', cancelAnchorScroll);
      }
    };

    anchorFrame = window.requestAnimationFrame(step);
  };

  const onAnchorClick = (event: MouseEvent) => {
    if (reduceMotion.matches || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.currentTarget as HTMLAnchorElement;
    const id = decodeURIComponent(link.hash.slice(1));
    const target = document.getElementById(id);
    if (!target) return;
    event.preventDefault();
    window.history.pushState(null, '', `#${id}`);
    animateToSection(target);
  };

  const initMotion = () => {
    sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-header nav a[href^="#"], .chapter-rail a[href^="#"]'));
    sections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));
    const sectionCounts = new Map<Element, number>();
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => {
      const group = element.closest('section') ?? document.body;
      const groupIndex = sectionCounts.get(group) ?? 0;
      sectionCounts.set(group, groupIndex + 1);
      element.style.setProperty('--reveal-delay', `${Math.min(groupIndex, 2) * 35}ms`);
      revealObserver.observe(element);
    });

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not(.skip-link)').forEach((link) => link.addEventListener('click', onAnchorClick));

    if (!reduceMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      document.querySelectorAll<HTMLElement>('.magnetic, .site-header nav a, .contact-links a').forEach((element) => {
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - .5) * 5;
          const y = ((event.clientY - rect.top) / rect.height - .5) * 5;
          element.style.setProperty('--magnetic-x', `${x}px`);
          element.style.setProperty('--magnetic-y', `${y}px`);
        }, { passive: true });
        element.addEventListener('pointerleave', () => {
          element.style.setProperty('--magnetic-x', '0px');
          element.style.setProperty('--magnetic-y', '0px');
        }, { passive: true });
      });
    }

    window.addEventListener('scroll', requestScrollUpdate, { passive: true });
    window.addEventListener('resize', requestScrollUpdate, { passive: true });
    updateScroll();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMotion, { once: true });
  else initMotion();
</script>
