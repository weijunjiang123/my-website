<div class="scroll-progress" aria-hidden="true"><i></i></div>

<script>
  const root = document.documentElement;
  const progress = document.querySelector<HTMLElement>('.scroll-progress i');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let sectionLinks: HTMLAnchorElement[] = [];
  let sections: HTMLElement[] = [];
  let parallaxItems: HTMLElement[] = [];
  let scrollFrame = 0;

  const updateScroll = () => {
    scrollFrame = 0;
    const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    const value = Math.min(Math.max(window.scrollY / max, 0), 1);
    progress?.style.setProperty('--progress', String(value));
    root.classList.toggle('is-scrolled', window.scrollY > 24);
    const readingLine = window.scrollY + window.innerHeight * .44;
    let currentId = sections[0]?.id ?? 'top';
    for (const section of sections) {
      if (section.offsetTop <= readingLine) currentId = section.id;
      else break;
    }
    setCurrentSection(currentId);

    if (!reduceMotion.matches && window.innerWidth > 1024) {
      for (const item of parallaxItems) {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -120 || rect.top > window.innerHeight + 120) continue;
        const amount = Number(item.dataset.scrollParallax ?? 16);
        const itemProgress = Math.min(Math.max((window.innerHeight - rect.top) / (window.innerHeight + rect.height), 0), 1);
        item.style.setProperty('--parallax-y', `${((itemProgress - .5) * amount).toFixed(2)}px`);
      }
    }
  };

  const requestScrollUpdate = () => {
    if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScroll);
  };

  const revealObserver = new IntersectionObserver((entries, observer) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    }
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });

  const setCurrentSection = (id: string) => {
    if (root.dataset.section === id) return;
    const nextIndex = sections.findIndex((section) => section.id === id);
    root.dataset.section = id;
    root.style.setProperty('--chapter-progress', String(nextIndex / Math.max(sections.length - 1, 1)));
    for (const section of sections) {
      const isCurrent = section.id === id;
      section.classList.toggle('is-current-section', isCurrent);
    }
    for (const link of sectionLinks) {
      const isCurrent = link.hash === `#${id}`;
      link.classList.toggle('is-current', isCurrent);
      if (isCurrent) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  const initMotion = () => {
    sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-header nav a[href^="#"]'));
    sections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));
    parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-parallax]'));
    const sectionCounts = new Map<Element, number>();
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => {
      const group = element.closest('section') ?? document.body;
      const groupIndex = sectionCounts.get(group) ?? 0;
      sectionCounts.set(group, groupIndex + 1);
      element.style.setProperty('--reveal-delay', `${Math.min(groupIndex, 2) * 35}ms`);
      revealObserver.observe(element);
    });

    if (!reduceMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.magnetic, .site-header nav a, .contact-links a').forEach((element) => {
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - .5) * 3;
          const y = ((event.clientY - rect.top) / rect.height - .5) * 3;
          element.style.setProperty('--magnetic-x', `${x}px`);
          element.style.setProperty('--magnetic-y', `${y}px`);
        }, { passive: true });
        element.addEventListener('pointerleave', () => {
          element.style.setProperty('--magnetic-x', '0px');
          element.style.setProperty('--magnetic-y', '0px');
        }, { passive: true });
      });
    }

    window.addEventListener('scroll', requestScrollUpdate, { passive: true });
    window.addEventListener('resize', requestScrollUpdate, { passive: true });
    updateScroll();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMotion, { once: true });
  else initMotion();
</script>
