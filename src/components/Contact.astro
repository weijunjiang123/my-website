---
import { profile } from '../data/profile';
import { translations, type Locale } from '../data/translations';
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const t = translations[lang].contact;
---
<section class="section contact-section shell" id="contact" aria-labelledby="contact-title">
  <div class="section-heading mono" data-reveal><span>04</span><h2 id="contact-title">{t.heading}</h2><span>{t.meta}</span></div>
  <div class="contact-main">
    <p data-reveal>{lang === 'zh' ? <><span class="contact-phrase">欢迎有意思的交流，</span><br/><span class="contact-phrase">也欢迎新的可能。</span></> : t.statement}</p>
    <div class="coordinates mono" aria-label={t.locationLabel}>
      <span class="target" aria-hidden="true"><i></i></span>
      <strong>{lang === 'zh' ? '中国 · 南京' : 'Nanjing, China'}</strong><span>{profile.coordinates}</span>
    </div>
  </div>
  <div class="contact-links mono" data-reveal>
    <a href={profile.email}>{t.email} <span>↗</span></a>
    <a href={profile.github} target="_blank" rel="noreferrer">{t.github} <span>↗</span></a>
    <a href={profile.linkedin} target="_blank" rel="noreferrer">{t.linkedin} <span>↗</span></a>
  </div>
</section>
